{
  "version": 2,
  "env": {
    "SOURCE_ORDER": "bilibili,dandan,bahamut,animeko,douban,360,renren,hanjutv"
  },
  "builds": [
    {
      "src": "danmu_api/worker.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/danmu_api/worker.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/danmu_api/worker.js"
    },
    {
      "src": "/([^/]+)/api/(.*)",
      "dest": "/danmu_api/worker.js"
    },
    {
      "src": "/(.*)",
      "dest": "/danmu_api/worker.js"
    }
  ]
}
